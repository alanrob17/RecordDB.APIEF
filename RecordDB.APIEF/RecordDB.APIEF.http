@RecordDB.APIEF_HostAddress = https://localhost:7097

# =======================================================================
# Artist Endpoints
# =======================================================================

### Get all artists
GET {{RecordDB.APIEF_HostAddress}}/api/artist
Accept: application/json

### Get artist by ID
GET {{RecordDB.APIEF_HostAddress}}/api/artist/1
Accept: application/json

### Search artists by partial name
GET {{RecordDB.APIEF_HostAddress}}/api/artist/search/Miles
Accept: application/json

### Get artists with no biography
GET {{RecordDB.APIEF_HostAddress}}/api/artist/no-biography
Accept: application/json

### Get artist with no biography by name
GET {{RecordDB.APIEF_HostAddress}}/api/artist/no-biography/Robyn%20Archer
Accept: application/json

### Get artist by Record ID
GET {{RecordDB.APIEF_HostAddress}}/api/artist/by-record/1
Accept: application/json

### Get biography by Record ID
GET {{RecordDB.APIEF_HostAddress}}/api/artist/biography/1
Accept: application/json

### Get artist ID by first and last name
GET {{RecordDB.APIEF_HostAddress}}/api/artist/artist-id?firstName=Miles&lastName=Davis
Accept: application/json

### Create artist
POST {{RecordDB.APIEF_HostAddress}}/api/artist
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Coltrane",
  "biography": "American jazz saxophonist and composer."
}

### Update artist
PUT {{RecordDB.APIEF_HostAddress}}/api/artist/1
Content-Type: application/json

{
  "artistId": 1,
  "firstName": "Miles",
  "lastName": "Davis",
  "name": "Miles Davis",
  "biography": "Influential American trumpeter, bandleader, and composer."
}

### Delete artist
DELETE {{RecordDB.APIEF_HostAddress}}/api/artist/999

# =======================================================================
# Record Endpoints
# =======================================================================

### Get all records with artist details
GET {{RecordDB.APIEF_HostAddress}}/api/record
Accept: application/json

### Get single record with artist details by ID
GET {{RecordDB.APIEF_HostAddress}}/api/record/1
Accept: application/json

### Get records filtered by show flag (e.g. cd, records, dvds, blurays, all, or year)
GET {{RecordDB.APIEF_HostAddress}}/api/record/show/cd
Accept: application/json

### Get records by artist name
GET {{RecordDB.APIEF_HostAddress}}/api/record/by-artist/Miles%20Davis
Accept: application/json

### Get records by recording year
GET {{RecordDB.APIEF_HostAddress}}/api/record/by-year/1970
Accept: application/json

### Get all records that have reviews
GET {{RecordDB.APIEF_HostAddress}}/api/record/reviews
Accept: application/json

### Get all records missing reviews
GET {{RecordDB.APIEF_HostAddress}}/api/record/no-reviews
Accept: application/json

### Get records that have no tracks
GET {{RecordDB.APIEF_HostAddress}}/api/record/no-tracks
Accept: application/json

### Get records with no tracks for a specific artist
GET {{RecordDB.APIEF_HostAddress}}/api/record/no-tracks/Miles%20Davis
Accept: application/json

### Search tracks by partial name
GET {{RecordDB.APIEF_HostAddress}}/api/record/tracks/search/Love
Accept: application/json

### Get records for an artist ID as flat Record objects
GET {{RecordDB.APIEF_HostAddress}}/api/record/by-artist-id/1
Accept: application/json

### Get per-artist total disc count and cost
GET {{RecordDB.APIEF_HostAddress}}/api/record/totals
Accept: application/json

### Count total discs by show flag
GET {{RecordDB.APIEF_HostAddress}}/api/record/disc-count/all
Accept: application/json

### Count total records for an artist
GET {{RecordDB.APIEF_HostAddress}}/api/record/count/artist/1
Accept: application/json

### Count total records for a recording year
GET {{RecordDB.APIEF_HostAddress}}/api/record/count/year/1970
Accept: application/json

### Create record
POST {{RecordDB.APIEF_HostAddress}}/api/record
Content-Type: application/json

{
  "artistId": 1,
  "name": "Kind of Blue (Special Edition)",
  "field": "Jazz",
  "recorded": 1959,
  "label": "Columbia",
  "pressing": "US",
  "rating": "****",
  "discs": 1,
  "media": "CD",
  "bought": "2024-01-15T00:00:00",
  "cost": 19.99,
  "coverName": "kind_of_blue.jpg",
  "review": "Masterpiece of modal jazz."
}

### Update record
PUT {{RecordDB.APIEF_HostAddress}}/api/record/1
Content-Type: application/json

{
  "recordId": 1,
  "artistId": 1,
  "name": "It Takes A Year",
  "field": "Acoustic",
  "recorded": 1977,
  "label": "Windham Hill",
  "pressing": "US",
  "rating": "****",
  "discs": 1,
  "media": "CD",
  "bought": "1990-07-15T00:00:00",
  "cost": 15.00,
  "coverName": "it_takes_a_year.jpg",
  "review": "Solo acoustic guitar."
}

### Delete record
DELETE {{RecordDB.APIEF_HostAddress}}/api/record/99999

# =======================================================================
# Disc Endpoints
# =======================================================================

### Get all discs
GET {{RecordDB.APIEF_HostAddress}}/api/disc
Accept: application/json

### Get single disc by ID
GET {{RecordDB.APIEF_HostAddress}}/api/disc/1
Accept: application/json

### Search discs by record name
GET {{RecordDB.APIEF_HostAddress}}/api/disc/search/Kind
Accept: application/json

### Create disc
POST {{RecordDB.APIEF_HostAddress}}/api/disc
Content-Type: application/json

{
  "recordId": 1,
  "discNo": 2,
  "freeDbDiscId": null,
  "freeDbId": null,
  "length": 3200
}

### Update disc
PUT {{RecordDB.APIEF_HostAddress}}/api/disc/1
Content-Type: application/json

{
  "discId": 1,
  "discNo": 1,
  "freeDbDiscId": null,
  "freeDbId": null,
  "length": 2400
}

### Update disc length only (PATCH)
PATCH {{RecordDB.APIEF_HostAddress}}/api/disc/1/length
Content-Type: application/json

{
  "length": 2450
}

### Delete disc
DELETE {{RecordDB.APIEF_HostAddress}}/api/disc/99999

# =======================================================================
# Track Endpoints
# =======================================================================

### Get all tracks
GET {{RecordDB.APIEF_HostAddress}}/api/track
Accept: application/json

### Get single track by ID
GET {{RecordDB.APIEF_HostAddress}}/api/track/1
Accept: application/json

### Search tracks by partial name
GET {{RecordDB.APIEF_HostAddress}}/api/track/search/So%20What
Accept: application/json

### Get tracks by artist name
GET {{RecordDB.APIEF_HostAddress}}/api/track/by-artist/Miles%20Davis
Accept: application/json

### Get tracks by record name
GET {{RecordDB.APIEF_HostAddress}}/api/track/by-record/Kind%20of%20Blue
Accept: application/json

### Get total track count for a record ID
GET {{RecordDB.APIEF_HostAddress}}/api/track/count/record/1
Accept: application/json

### Check track count for a disc ID
GET {{RecordDB.APIEF_HostAddress}}/api/track/check/disc/1
Accept: application/json

### Create track
POST {{RecordDB.APIEF_HostAddress}}/api/track
Content-Type: application/json

{
  "discId": 1,
  "trackNo": 10,
  "name": "Bonus Track",
  "trackLength": 180,
  "extended": "Recorded live in 1978"
}

### Bulk create tracks
POST {{RecordDB.APIEF_HostAddress}}/api/track/bulk
Content-Type: application/json

[
  {
    "discId": 1,
    "trackNo": 11,
    "name": "Live Intro",
    "trackLength": 60,
    "extended": null
  },
  {
    "discId": 1,
    "trackNo": 12,
    "name": "Live Outro",
    "trackLength": 90,
    "extended": null
  }
]

### Update track
PUT {{RecordDB.APIEF_HostAddress}}/api/track/1
Content-Type: application/json

{
  "trackId": 1,
  "discId": 1,
  "trackNo": 1,
  "name": "The Bricklayer's Beautiful Daughter",
  "trackLength": 218,
  "extended": null
}

### Delete track
DELETE {{RecordDB.APIEF_HostAddress}}/api/track/99999
